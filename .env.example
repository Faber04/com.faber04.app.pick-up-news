# Copy this file to .env.local and fill in the values.

# Cloudflare Worker CORS proxy URL (see workers/).
# After deploying the worker with `npx wrangler deploy` (from workers/),
# paste the generated URL below (must end with /?url=).
# If not set, falls back to corsproxy.io (localhost only).
VITE_CORS_PROXY_URL=https://pickupnews-cors-proxy.<your-subdomain>.workers.dev/?url=
